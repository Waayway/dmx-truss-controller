.PHONY: all check clean 3mf/ring-two-colour.3mf
OPENSCAD ?= openscad
PARTS = base front_plate column display_carrier rotor_hub pedestal

all: $(addprefix stl/,$(addsuffix .stl,$(PARTS))) stl/ring.stl stl/assembly-preview.stl stl/layout-ghosts.stl

stl/%.stl: %.scad params.scad
	@mkdir -p stl
	$(OPENSCAD) -o $@ $<

stl/assembly-preview.stl: assembly.scad params.scad $(addsuffix .scad,$(PARTS))
	@mkdir -p stl
	$(OPENSCAD) -o $@ $<

stl/layout-ghosts.stl: ghosts.scad params.scad
	@mkdir -p stl
	$(OPENSCAD) -o $@ $<

check:
	../scripts/check.sh

clean:
	rm -f stl/*.stl

# ring: plain body from OpenSCAD, diamond knurl generated by node (no boolean ops), then merged (one colour) or packed into a 3MF (two colours)
stl/ring-body.stl: ring.scad params.scad
	@mkdir -p stl
	$(OPENSCAD) -o $@ ring.scad

stl/ring-ribs.stl stl/ring.stl: stl/ring-body.stl ../scripts/knurl.mjs params.scad
	node ../scripts/knurl.mjs

3mf/ring-two-colour.3mf: stl/ring-body.stl stl/ring-ribs.stl ../scripts/make-3mf.mjs
	node ../scripts/make-3mf.mjs
